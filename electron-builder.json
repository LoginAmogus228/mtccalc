{
  "name": "mtc-art-computer",
  "version": "3.0.0",
  "description": "MTC Artillery Fire Control System with AI",
  "main": "electron/main.js",
  "author": "MTC",
  "license": "MIT",
  "scripts": {
    "electron:dev": "electron .",
    "electron:build": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.mtc.artcomputer",
    "productName": "MTC Art Computer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "icon.ico",
      "artifactName": "MTC-ArtComputer-v3.0-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MTC Art Computer"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}
